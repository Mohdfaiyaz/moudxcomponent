import React, { useState, useEffect } from 'react';
import { withConfiguration } from '@pega/cosmos-react-core';
import type { PConnFieldProps } from '../shared/PConnProps';

export interface Employee {
  pyGUID?: string;
  EmployeeFullName: string;
  Gender: string;
  DateOfBirth: string;
  DateOfJoining: string;
  EmploymentType: string;
  PersonalEmailAddress: string;
  OfficialEmailAddress: string;
  PrimaryContactNumber: string;
  pyStatusValue?: string;
}

export function CapgeminiHrFlow360EmployeeKanbanMode(props: PConnFieldProps) {
  const pConn = props.getPConnect?.();
  const actions = pConn?.getActionsApi?.();

  const [employees, setEmployees] = useState<Employee[]>([]);

  // Helper function to read current clipboard state and print full array JSON directly to console
  const logCurrentPegaJson = (contextName: string) => {
    if (!pConn) return;
    const latestListData = pConn.getValue?.('.ListOfEmployee');
    if (latestListData) {
      const freshList = Array.isArray(latestListData)
        ? latestListData
        : Object.values(latestListData);
      console.log(`📋 [${contextName} Output] Full ListOfEmployee JSON Code Payload:`);
      console.log(JSON.stringify(freshList, null, 2));
    }
  };

  // 1. Initial Load from Pega Clipboard
  useEffect(() => {
    if (pConn) {
      const listData = pConn.getValue?.('.ListOfEmployee');
      if (listData) {
        const parsedList: Employee[] = Array.isArray(listData) ? listData : Object.values(listData);
        setEmployees(parsedList);
      }
    }
  }, [pConn]);

  // 2. Click Handler: Updates ONLY the scalar string field paths for a single row
  const moveEmployeeToSelected = (originalIndex: number) => {
    if (!actions) return;

    const currentEmployee = employees[originalIndex];
    if (!currentEmployee) return;

    const nextStatus = 'Yes';

    // Update local UI state immediately so the card shifts smoothly
    setEmployees(prevList => {
      const nextList = [...prevList];
      if (nextList[originalIndex]) {
        nextList[originalIndex] = {
          ...nextList[originalIndex],
          pyStatusValue: nextStatus
        };
      }
      return nextList;
    });

    // Fire isolated field-level string updates matching her exact path concatenation template
    const basePath = `.ListOfEmployee(${originalIndex + 1})`;
    try {
      actions.updateFieldValue(`${basePath}.EmployeeFullName`, currentEmployee.EmployeeFullName);
      actions.updateFieldValue(`${basePath}.pyStatusValue`, nextStatus);
      console.log(`✅ [Card Click Success]: Target fields saved at ${basePath}`);

      // Wait for Pega updates to commit to the local store model before printing full payload
      setTimeout(() => {
        logCurrentPegaJson('SINGLE CARD CLICK');
      }, 100);
    } catch (err) {
      console.error(`❌ Error on card click path ${basePath}:`, err);
    }
  };

  // 3. Your Master Save Button Routine (Maintained Exactly as Verified)
  const updateAllStatuses = () => {
    if (!pConn || !actions) return;

    const listData = pConn.getValue?.('.ListOfEmployee');
    if (!listData) return;

    const currentList = Array.isArray(listData) ? listData : Object.values(listData);

    for (const [index, item] of currentList.entries()) {
      const basePath = `.ListOfEmployee(${index + 1})`;
      const employeeItem = item as Employee;

      try {
        actions.updateFieldValue(
          `${basePath}.EmployeeFullName`,
          employeeItem.EmployeeFullName || ''
        );
        actions.updateFieldValue(`${basePath}.pyStatusValue`, 'Yes');
        console.log(`✅ Success: Updated ${basePath} fields via Master Button`);
      } catch (err) {
        console.error(`❌ Error on path ${basePath}:`, err);
      }
    }

    // Wait for the bulk loop actions to commit before printing full payload
    setTimeout(() => {
      logCurrentPegaJson('UPDATE ALL STATUSES BUTTON');
    }, 100);
  };

  // Separate items into columns for the static UI layout configuration
  const existingEmployees = employees
    .map((emp, index) => ({ emp, originalIndex: index }))
    .filter(item => item.emp.pyStatusValue !== 'Yes');

  const selectedEmployees = employees
    .map((emp, index) => ({ emp, originalIndex: index }))
    .filter(item => item.emp.pyStatusValue === 'Yes');

  return (
    <div>
      {/* Master Save Button */}
      <div style={{ marginBottom: '20px' }}>
        <button type='button' onClick={updateAllStatuses}>
          Update All Statuses
        </button>
      </div>

      {/* Kanban UI Layout */}
      <div style={{ display: 'flex', gap: '20px' }}>
        {/* Column 1: Existing Employee */}
        <div
          style={{ border: '1px solid black', width: '350px', minHeight: '400px', padding: '10px' }}
        >
          <h4>Existing Employee (Scoped)</h4>
          {existingEmployees.map(({ emp, originalIndex }) => (
            <div
              key={emp.pyGUID || emp.EmployeeFullName || originalIndex}
              style={{
                border: '1px dashed gray',
                padding: '10px',
                marginBottom: '8px',
                background: '#f9f9f9'
              }}
            >
              <p>
                <strong>Name:</strong> {emp.EmployeeFullName || 'Unnamed Employee'}
              </p>
              <p>
                <small>Status: {emp.pyStatusValue || 'No'}</small>
              </p>

              <button
                type='button'
                onClick={() => moveEmployeeToSelected(originalIndex)}
                style={{ marginTop: '5px', cursor: 'pointer' }}
              >
                Select Employee →
              </button>
            </div>
          ))}
        </div>

        {/* Column 2: Selected Employee */}
        <div
          style={{ border: '1px solid black', width: '350px', minHeight: '400px', padding: '10px' }}
        >
          <h4>Selected Employee</h4>
          {selectedEmployees.map(({ emp, originalIndex }) => (
            <div
              key={emp.pyGUID || emp.EmployeeFullName || originalIndex}
              style={{
                border: '1px dashed gray',
                padding: '10px',
                marginBottom: '8px',
                background: '#e6f7ff'
              }}
            >
              <p>
                <strong>Name:</strong> {emp.EmployeeFullName || 'Unnamed Employee'}
              </p>
              <p>
                <small>Status: {emp.pyStatusValue}</small>
              </p>
            </div>
          ))}
        </div>
      </div>
    </div>
  );
}

export default withConfiguration(CapgeminiHrFlow360EmployeeKanbanMode);
